---
deadlock_detection: false
options:
    crash_on_yield: false
    max_concurrent_actions: 1
action_options:
    "Writer.Put":
        max_actions: 2
    "Writer.Delete":
        max_actions: 1
    "Writer.BatchSwap":
        max_actions: 1
    "Writer.AbortedPut":
        max_actions: 1
    "SnapshotReader.BeginSnapshot":
        max_actions: 1
    "SnapshotReader.EndSnapshot":
        max_actions: 1
---

NOT_FOUND = "NOT_FOUND"
KEYS = ["k1", "k2"]
VALUES = ["v1", "v2"]

# Black-box external contract for GroundKV's public API.
# Notice ZERO storage internals (no meta0/meta1, no pgids, no freelist) appear
# in this specification — any internal storage rewrite must still satisfy it.
#
# Roles:
#   - Writer#0:         serialized writer executing Put, Delete, multi-key atomic
#                       BatchSwap, and aborted (rolled-back) transactions.
#   - Reader#0, #1:     concurrent lock-free readers executing Get and ScanAll
#                       in parallel goroutines (max-parallel-runs > 0 + -race).
#   - SnapshotReader#0: pins an MVCC snapshot across concurrent writes.
role Writer:
    action Init:
        pass

    atomic action Put:
        k = oneof KEYS
        v = oneof VALUES
        kv[k] = v
        return "OK"

    atomic action Delete:
        k = oneof KEYS
        if k in kv:
            kv.pop(k)
        return "OK"

    # Multi-key atomic transaction: writes both k1 and k2 with the same value
    # in a single Update(). Concurrent ScanAll() must NEVER observe a half-applied batch!
    atomic action BatchSwap:
        v = oneof VALUES
        kv["k1"] = v
        kv["k2"] = v
        return "OK"

    # Explicit write transaction that stages a mutation and rolls back.
    # No concurrent reader may ever observe the aborted value.
    atomic action AbortedPut:
        k = oneof KEYS
        v = oneof VALUES
        return "ABORTED"

role Reader:
    action Init:
        pass

    atomic action Get:
        k = oneof KEYS
        return kv.get(k, NOT_FOUND)

    atomic action ScanAll:
        return format_kv(kv)

role SnapshotReader:
    action Init:
        self.active = False
        self.snap = {}

    atomic action BeginSnapshot:
        if self.active:
            return "BUSY"
        self.active = True
        self.snap = dict(kv)
        return "OK"

    atomic action SnapshotGet:
        k = oneof KEYS
        if not self.active:
            return NOT_FOUND
        return self.snap.get(k, NOT_FOUND)

    atomic action EndSnapshot:
        if not self.active:
            return "NONE"
        self.active = False
        self.snap = {}
        return "OK"

def format_kv(m):
    parts = []
    for k in sorted(m.keys()):
        parts.append(k + "=" + m[k])
    return ",".join(parts)

action Init:
    kv = {}
    writer = Writer()
    reader0 = Reader()
    reader1 = Reader()
    snap_reader = SnapshotReader()

always assertion SnapshotCleanWhenClosed:
    if not snap_reader.active:
        return len(snap_reader.snap) == 0
    return True
