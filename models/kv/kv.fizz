---
deadlock_detection: false
options:
    crash_on_yield: false
    max_concurrent_actions: 1
action_options:
    "DB.Put":
        max_actions: 2
    "DB.Delete":
        max_actions: 1
    "DB.BeginRead":
        max_actions: 1
    "DB.EndRead":
        max_actions: 1
    "DB.BeginWrite":
        max_actions: 1
    "DB.StagePut":
        max_actions: 1
    "DB.CommitWrite":
        max_actions: 1
    "DB.RollbackWrite":
        max_actions: 1
    "DB.CrashAndReopen":
        max_actions: 1
---

NOT_FOUND = "NOT_FOUND"
KEYS = ["k1", "k2"]
VALUES = ["v1", "v2"]

role DB:
    action Init:
        # Dual meta pages (page 0 and page 1) as in BoltDB/LMDB.
        # Each meta page records (txid, state_snapshot).
        # Committed data is immutable once written; commit flips the older meta page.
        self.txid = 0
        self.meta0_txid = 0
        self.meta1_txid = 0
        self.meta0 = {}
        self.meta1 = {}

        # Currently active committed view (mirrors meta with highest txid)
        self.committed = {}

        # Active MVCC read-only snapshot (None when no snapshot is open)
        self.has_snapshot = False
        self.snapshot = {}

        # Single-writer uncommitted transaction state
        self.in_write_tx = False
        self.staged = {}

    # Convenience atomic Put (BeginWrite -> Put -> Commit)
    atomic action Put:
        k = oneof KEYS
        v = oneof VALUES
        if self.in_write_tx:
            return "BUSY"
        next_state = dict(self.committed)
        next_state[k] = v
        self.commit_state(next_state)
        return "OK"

    # Convenience atomic Delete (BeginWrite -> Delete -> Commit)
    atomic action Delete:
        k = oneof KEYS
        if self.in_write_tx:
            return "BUSY"
        next_state = dict(self.committed)
        if k in next_state:
            next_state.pop(k)
        self.commit_state(next_state)
        return "OK"

    # Point read against latest committed state
    atomic action Get:
        k = oneof KEYS
        return self.committed.get(k, NOT_FOUND)

    # Start a read-only MVCC snapshot transaction
    atomic action BeginRead:
        if self.has_snapshot:
            return "BUSY"
        self.has_snapshot = True
        self.snapshot = dict(self.committed)
        return "OK"

    # Read a key from the open MVCC snapshot
    atomic action SnapshotGet:
        k = oneof KEYS
        if not self.has_snapshot:
            return NOT_FOUND
        return self.snapshot.get(k, NOT_FOUND)

    # Close the open MVCC snapshot
    atomic action EndRead:
        if not self.has_snapshot:
            return "NONE"
        self.has_snapshot = False
        self.snapshot = {}
        return "OK"

    # Explicit multi-step write transaction: BeginWrite -> StagePut -> Commit / Rollback
    atomic action BeginWrite:
        if self.in_write_tx:
            return "BUSY"
        self.in_write_tx = True
        self.staged = dict(self.committed)
        return "OK"

    atomic action StagePut:
        k = oneof KEYS
        v = oneof VALUES
        if not self.in_write_tx:
            return "NO_TX"
        self.staged[k] = v
        return "OK"

    atomic action CommitWrite:
        if not self.in_write_tx:
            return "NO_TX"
        self.commit_state(dict(self.staged))
        self.in_write_tx = False
        self.staged = {}
        return "OK"

    atomic action RollbackWrite:
        if not self.in_write_tx:
            return "NO_TX"
        self.in_write_tx = False
        self.staged = {}
        return "OK"

    # Simulate an abrupt process crash (drops uncommitted write tx and open read handles)
    # and reopen from dual meta pages on disk.
    atomic action CrashAndReopen:
        self.in_write_tx = False
        self.staged = {}
        self.has_snapshot = False
        self.snapshot = {}
        # Recovery chooses the meta page with the higher valid txid
        if self.meta0_txid >= self.meta1_txid:
            self.txid = self.meta0_txid
            self.committed = dict(self.meta0)
        else:
            self.txid = self.meta1_txid
            self.committed = dict(self.meta1)
        return self.txid

    def commit_state(self, next_state):
        self.txid += 1
        # Write to the alternating meta slot (txid % 2)
        if self.txid % 2 == 0:
            self.meta0_txid = self.txid
            self.meta0 = dict(next_state)
        else:
            self.meta1_txid = self.txid
            self.meta1 = dict(next_state)
        self.committed = dict(next_state)

action Init:
    db = DB()

# Safety Invariant 1: Dual meta pages always bracket the current committed txid,
# and the newer meta page matches the committed KV map exactly.
always assertion DualMetaConsistency:
    if db.meta0_txid >= db.meta1_txid:
        active_txid = db.meta0_txid
        active_map = db.meta0
    else:
        active_txid = db.meta1_txid
        active_map = db.meta1
    if active_txid != db.txid:
        return False
    if active_map != db.committed:
        return False
    diff = db.meta0_txid - db.meta1_txid
    if diff < -1 or diff > 1:
        return False
    return True

# Safety Invariant 2: Uncommitted write transaction never leaks into committed state.
always assertion NoWriteTxLeak:
    if not db.in_write_tx:
        return len(db.staged) == 0
    return True

# Safety Invariant 3: Closed snapshot leaves no stale snapshot state.
always assertion CleanSnapshotState:
    if not db.has_snapshot:
        return len(db.snapshot) == 0
    return True
