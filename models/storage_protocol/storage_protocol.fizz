---
deadlock_detection: false
options:
    crash_on_yield: false
    max_concurrent_actions: 1
action_options:
    "Engine.BeginPut":
        max_actions: 3
    "Engine.StageOverwrite":
        max_actions: 1
    "Engine.BeginDelete":
        max_actions: 1
    "Engine.RollbackWrite":
        max_actions: 1
    "Engine.OpenReader":
        max_actions: 1
    "Engine.CloseReader":
        max_actions: 1
    "Disk.FailSync":
        max_actions: 1
    "Disk.Crash":
        max_actions: 1
---

NOT_FOUND = "NOT_FOUND"
KEY = "k1"
CRASH_MODES = ["DROP", "REORDERED", "TORN"]

PHASE_IDLE = "IDLE"
PHASE_STAGED = "STAGED"
PHASE_DATA_WRITTEN = "DATA_WRITTEN"
PHASE_DATA_SYNCED = "DATA_SYNCED"
PHASE_META_WRITTEN = "META_WRITTEN"

# Unified white-box storage protocol specification modeling:
#   1. Disk role with separate volatile (pending) vs durable page & meta buffers
#      and three crash fault modes:
#        - DROP:      drops all unsynced data & meta writes
#        - REORDERED: persists unsynced meta write while dropping unsynced data
#        - TORN:      corrupts target meta slot on unsynced meta write
#   2. Engine role with real abstract PageIDs (pgid >= 2), COW allocation,
#      freelist pending[txid] -> free reclamation gated by
#        release_bound = min(max(0, txid - 1), min_active_reader_txid),
#      Put + Delete + RollbackWrite + 4-phase CommitStep + MVCC Reader.
#
# ZERO ghost booleans: every safety assertion inspects real modeled pages,
# real durable meta roots, and real reader roots so breaking either the data
# Sync barrier or the MVCC/dual-meta freelist watermark produces a concrete
# FizzBee counterexample.
role Disk:
    action Init:
        # Durable on-disk B+Tree page contents: pgid -> value (or "" if empty)
        self.durable_pages = {}
        # Unsynced OS page-cache writes: pgid -> value
        self.pending_pages = {}

        # Dual meta slots on durable disk (slot 0 for even txid, slot 1 for odd txid)
        self.meta0_valid = True
        self.meta0_txid = 0
        self.meta0_root = 0
        self.meta0_expected = NOT_FOUND

        self.meta1_valid = True
        self.meta1_txid = 0
        self.meta1_root = 0
        self.meta1_expected = NOT_FOUND

        # Unsynced meta page write sitting in OS page cache.
        # pending_meta_valid=True represents a valid WriteMeta(slot, ...);
        # pending_meta_valid=False represents an InvalidateMeta(slot) zero-write
        # performed by Rollback after a failed SyncMetaPage.
        self.has_pending_meta = False
        self.pending_meta_valid = False
        self.pending_meta_slot = 0
        self.pending_meta_txid = 0
        self.pending_meta_root = 0
        self.pending_meta_expected = NOT_FOUND

    atomic func WritePage(pgid, val):
        self.pending_pages[pgid] = val

    atomic func WriteMeta(slot, txid, root, expected_val):
        self.has_pending_meta = True
        self.pending_meta_valid = True
        self.pending_meta_slot = slot
        self.pending_meta_txid = txid
        self.pending_meta_root = root
        self.pending_meta_expected = expected_val

    atomic func InvalidateMeta(slot):
        self.has_pending_meta = True
        self.pending_meta_valid = False
        self.pending_meta_slot = slot
        self.pending_meta_txid = 0
        self.pending_meta_root = 0
        self.pending_meta_expected = NOT_FOUND

    atomic func Sync():
        for pgid in self.pending_pages:
            self.durable_pages[pgid] = self.pending_pages[pgid]
        self.pending_pages = {}
        if self.has_pending_meta:
            if self.pending_meta_valid:
                self.apply_durable_meta(
                    self.pending_meta_slot,
                    self.pending_meta_txid,
                    self.pending_meta_root,
                    self.pending_meta_expected,
                )
            else:
                self.invalidate_durable_meta(self.pending_meta_slot)
            self.has_pending_meta = False
            self.pending_meta_valid = False

    def apply_durable_meta(self, slot, txid, root, expected_val):
        if slot == 0:
            self.meta0_valid = True
            self.meta0_txid = txid
            self.meta0_root = root
            self.meta0_expected = expected_val
        else:
            self.meta1_valid = True
            self.meta1_txid = txid
            self.meta1_root = root
            self.meta1_expected = expected_val

    def invalidate_durable_meta(self, slot):
        if slot == 0:
            self.meta0_valid = False
            self.meta0_txid = 0
            self.meta0_root = 0
            self.meta0_expected = NOT_FOUND
        else:
            self.meta1_valid = False
            self.meta1_txid = 0
            self.meta1_root = 0
            self.meta1_expected = NOT_FOUND

    # Power-loss fault action parameterized by crash mode (supports back-to-back crashes!).
    atomic action Crash:
        mode = oneof CRASH_MODES
        self.pending_pages = {}
        if mode == "DROP":
            self.has_pending_meta = False
            self.pending_meta_valid = False
        elif mode == "REORDERED":
            # Flushes unsynced meta (valid or invalidated) while dropping unsynced data pages!
            if self.has_pending_meta:
                if self.pending_meta_valid:
                    self.apply_durable_meta(
                        self.pending_meta_slot,
                        self.pending_meta_txid,
                        self.pending_meta_root,
                        self.pending_meta_expected,
                    )
                else:
                    self.invalidate_durable_meta(self.pending_meta_slot)
                self.has_pending_meta = False
                self.pending_meta_valid = False
        elif mode == "TORN":
            # Corrupts the target meta slot if an unsynced meta write is in flight!
            if self.has_pending_meta:
                self.invalidate_durable_meta(self.pending_meta_slot)
                self.has_pending_meta = False
                self.pending_meta_valid = False
        txid = engine.recover_after_crash()
        return txid

    # Fault 4: Realistic POSIX Sync() I/O failure on a live process — fsync()
    # returns an error WITHOUT discarding dirty OS page-cache buffers. Engine
    # must explicitly neutralize any dirty alternate meta slot on Rollback so a
    # later transaction's SyncDataPages() cannot resurrect the aborted commit.
    atomic action FailSync:
        res = engine.abort_on_sync_error()
        return res

    # Read-only durable meta inspection (uncapped pure read: 0 extra states) so MBT
    # verifies BOTH on-disk durable meta slots without coupling to abstract pgid maps.
    atomic action InspectMeta:
        m0v = "1" if self.meta0_valid else "0"
        m1v = "1" if self.meta1_valid else "0"
        return "m0=" + m0v + ":" + str(self.meta0_txid) + ":" + self.meta0_expected + "|m1=" + m1v + ":" + str(self.meta1_txid) + ":" + self.meta1_expected

role Engine:
    action Init:
        self.txid = 0
        self.root = 0
        self.committed_val = NOT_FOUND

        # Real abstract page allocator & freelist
        self.next_pgid = 2
        self.free_pages = []
        self.pending_free = {}

        # Active MVCC reader snapshot (has_reader=False when closed)
        self.has_reader = False
        self.reader_txid = -1
        self.reader_root = 0
        self.reader_expected = NOT_FOUND

        # Active single-writer 4-phase transaction state
        self.phase = PHASE_IDLE
        self.tx_root = 0
        self.tx_staged_val = NOT_FOUND
        self.tx_freed = []
        self.tx_recycled = []
        self.tx_dirty_written = False

        self.last_acked_txid = 0

    atomic action BeginPut:
        if self.phase != PHASE_IDLE:
            return "BUSY"
        self.release_eligible()
        next_val = "v" + str(self.txid + 1)
        self.stage_mutation(next_val, True)
        return "OK"

    # Second mutation inside an already-staged write tx: exercises read-your-own-writes
    # and overwriting an uncommitted dirty page (delete(tx.dirty, pgid)) before commit/rollback.
    atomic action StageOverwrite:
        if self.phase != PHASE_STAGED:
            return "NO_TX"
        next_val = "w" + str(self.txid + 1)
        self.tx_staged_val = next_val
        if self.tx_root == 0:
            self.tx_root = self.alloc_pgid()
            self.tx_dirty_written = True
        return next_val

    atomic action BeginDelete:
        if self.phase != PHASE_IDLE:
            return "BUSY"
        self.release_eligible()
        changed = self.committed_val != NOT_FOUND
        self.stage_mutation(NOT_FOUND, changed)
        return "OK"

    def stage_mutation(self, next_val, changed):
        self.tx_staged_val = next_val
        self.tx_freed = []
        self.tx_recycled = []
        self.tx_dirty_written = False
        if not changed:
            self.tx_root = self.root
        elif next_val == NOT_FOUND:
            if self.root != 0:
                self.tx_freed = [self.root]
            self.tx_root = 0
        else:
            if self.root != 0:
                self.tx_freed = [self.root]
            new_pgid = self.alloc_pgid()
            self.tx_root = new_pgid
            self.tx_dirty_written = True
        self.phase = PHASE_STAGED

    def alloc_pgid(self):
        if len(self.free_pages) > 0:
            lowest = min(self.free_pages)
            self.free_pages.remove(lowest)
            self.tx_recycled.append(lowest)
            return lowest
        pgid = self.next_pgid
        self.next_pgid += 1
        return pgid

    # Advance the active write transaction by one durability phase:
    #   STAGED -> DATA_WRITTEN -> DATA_SYNCED -> META_WRITTEN -> IDLE (COMMITTED)
    atomic action CommitStep:
        if self.phase == PHASE_IDLE:
            return "IDLE"
        if self.phase == PHASE_STAGED:
            if self.tx_dirty_written:
                disk.WritePage(self.tx_root, self.tx_staged_val)
            self.phase = PHASE_DATA_WRITTEN
            return "DATA_WRITTEN"
        if self.phase == PHASE_DATA_WRITTEN:
            if self.tx_dirty_written or len(self.free_pages) > 0 or len(self.pending_free) > 0:
                disk.Sync()
            self.phase = PHASE_DATA_SYNCED
            return "DATA_SYNCED"
        if self.phase == PHASE_DATA_SYNCED:
            next_txid = self.txid + 1
            disk.WriteMeta(next_txid % 2, next_txid, self.tx_root, self.tx_staged_val)
            self.phase = PHASE_META_WRITTEN
            return "META_WRITTEN"
        if self.phase == PHASE_META_WRITTEN:
            disk.Sync()
            next_txid = self.txid + 1
            self.txid = next_txid
            self.root = self.tx_root
            self.committed_val = self.tx_staged_val
            self.last_acked_txid = next_txid
            if len(self.tx_freed) > 0:
                self.pending_free[next_txid] = list(self.tx_freed)
            self.clear_tx()
            self.release_eligible()
            return "COMMITTED"
        return "IDLE"

    # Rollback an uncommitted staged write tx and restore any recycled free pages.
    atomic action RollbackWrite:
        if self.phase != PHASE_STAGED:
            return "NO_TX"
        for pgid in self.tx_recycled:
            if pgid not in self.free_pages:
                self.free_pages.append(pgid)
        self.clear_tx()
        return "OK"

    atomic action OpenReader:
        if self.has_reader:
            return -1
        self.has_reader = True
        self.reader_txid = self.txid
        self.reader_root = self.root
        self.reader_expected = self.committed_val
        return self.txid

    atomic action CloseReader:
        if not self.has_reader:
            return "NONE"
        self.has_reader = False
        self.reader_txid = -1
        self.reader_root = 0
        self.reader_expected = NOT_FOUND
        self.release_eligible()
        return "OK"

    atomic action Read:
        return self.committed_val

    atomic action ReadSnapshot:
        if not self.has_reader:
            return NOT_FOUND
        return self.reader_expected

    def clear_tx(self):
        self.phase = PHASE_IDLE
        self.tx_root = 0
        self.tx_staged_val = NOT_FOUND
        self.tx_freed = []
        self.tx_recycled = []
        self.tx_dirty_written = False

    def release_bound(self):
        bound = 0
        if self.txid > 0:
            bound = self.txid - 1
        if self.has_reader and self.reader_txid < bound:
            bound = self.reader_txid
        return bound

    def release_eligible(self):
        bound = self.release_bound()
        to_release = []
        for t in self.pending_free:
            if t <= bound:
                to_release.append(t)
        for t in sorted(to_release):
            for pgid in self.pending_free[t]:
                if pgid not in self.free_pages:
                    self.free_pages.append(pgid)
            self.pending_free.pop(t)

    atomic func recover_after_crash():
        self.clear_tx()
        self.has_reader = False
        self.reader_txid = -1
        self.reader_root = 0
        self.reader_expected = NOT_FOUND

        if disk.meta0_valid and disk.meta1_valid:
            if disk.meta0_txid >= disk.meta1_txid:
                self.txid = disk.meta0_txid
                self.root = disk.meta0_root
            else:
                self.txid = disk.meta1_txid
                self.root = disk.meta1_root
        elif disk.meta0_valid:
            self.txid = disk.meta0_txid
            self.root = disk.meta0_root
        elif disk.meta1_valid:
            self.txid = disk.meta1_txid
            self.root = disk.meta1_root

        if self.root == 0:
            self.committed_val = NOT_FOUND
        else:
            self.committed_val = disk.durable_pages.get(self.root, NOT_FOUND)

        self.free_pages = []
        self.pending_free = {}
        recovered_freed = []
        live_on_disk = set()
        if disk.meta0_valid and disk.meta0_root != 0:
            live_on_disk.add(disk.meta0_root)
        if disk.meta1_valid and disk.meta1_root != 0:
            live_on_disk.add(disk.meta1_root)
        for pgid in disk.durable_pages:
            if pgid != self.root and pgid not in live_on_disk:
                recovered_freed.append(pgid)
        if len(recovered_freed) > 0 and self.txid >= 2:
            self.pending_free[self.txid] = sorted(recovered_freed)

        self.last_acked_txid = self.txid
        return self.txid

    atomic func abort_on_sync_error():
        if self.phase != PHASE_DATA_WRITTEN and self.phase != PHASE_META_WRITTEN:
            return "SKIP"
        if self.phase == PHASE_META_WRITTEN:
            next_txid = self.txid + 1
            disk.InvalidateMeta(next_txid % 2)
            held = list(self.tx_recycled)
            if self.tx_dirty_written and self.tx_root != 0 and self.tx_root not in held:
                held.append(self.tx_root)
            if len(held) > 0:
                existing = list(self.pending_free.get(next_txid, []))
                for pgid in held:
                    if pgid not in existing:
                        existing.append(pgid)
                self.pending_free[next_txid] = sorted(existing)
        else:
            for pgid in self.tx_recycled:
                if pgid not in self.free_pages:
                    self.free_pages.append(pgid)
        self.clear_tx()
        return "SYNC_FAILED"

action Init:
    disk = Disk()
    engine = Engine()

# Invariant 1: Dual meta slots NEVER both become invalid, even under back-to-back torn crashes.
always assertion AtLeastOneValidMeta:
    return disk.meta0_valid or disk.meta1_valid

# Invariant 2: Every valid durable meta page points to a durable root page
# whose contents match its committed value.
# (Fails immediately if disk.Sync() is omitted before disk.WriteMeta()!)
always assertion ValidMetaRootsMatchDurablePages:
    if disk.meta0_valid:
        if disk.meta0_root == 0:
            if disk.meta0_expected != NOT_FOUND:
                return False
        else:
            if disk.meta0_root not in disk.durable_pages:
                return False
            if disk.durable_pages[disk.meta0_root] != disk.meta0_expected:
                return False
    if disk.meta1_valid:
        if disk.meta1_root == 0:
            if disk.meta1_expected != NOT_FOUND:
                return False
        else:
            if disk.meta1_root not in disk.durable_pages:
                return False
            if disk.durable_pages[disk.meta1_root] != disk.meta1_expected:
                return False
    return True

# Invariant 3: ZERO use-after-free — no page reachable from either durable meta
# slot, active root, or open MVCC reader ever enters free_pages!
# (Fails immediately if release_bound omits reader_txid OR txid-1!)
always assertion NoLivePageInFreelist:
    live = set()
    if disk.meta0_valid and disk.meta0_root != 0:
        live.add(disk.meta0_root)
    if disk.meta1_valid and disk.meta1_root != 0:
        live.add(disk.meta1_root)
    if engine.root != 0:
        live.add(engine.root)
    if engine.has_reader and engine.reader_root != 0:
        live.add(engine.reader_root)
    for pgid in engine.free_pages:
        if pgid in live:
            return False
    return True

# Invariant 4: Open MVCC reader's pinned root page stays durable and unmodified on disk.
always assertion ReaderSeesIntactDurablePage:
    if not engine.has_reader:
        return True
    if engine.reader_root == 0:
        return engine.reader_expected == NOT_FOUND
    if engine.reader_root not in disk.durable_pages:
        return False
    return disk.durable_pages[engine.reader_root] == engine.reader_expected

# Invariant 5: Durability — committed txid never regresses below last acknowledged commit.
always assertion CommittedTxIDNeverRegresses:
    return engine.txid >= engine.last_acked_txid

# Invariant 6: No resurrected aborted commit — a failed SyncMetaPage must never
# leave a valid dirty meta slot that a subsequent SyncDataPages flushes to disk.
always assertion NoResurrectedAbortedMeta:
    max_allowed = engine.txid + 1 if engine.phase == PHASE_META_WRITTEN else engine.txid
    if disk.meta0_valid and disk.meta0_txid > max_allowed:
        return False
    if disk.meta1_valid and disk.meta1_txid > max_allowed:
        return False
    return True
