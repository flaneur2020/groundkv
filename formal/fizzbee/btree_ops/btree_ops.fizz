---
deadlock_detection: false
options:
    crash_on_yield: false
    max_concurrent_actions: 1
action_options:
    "BTree.BulkLoad":
        max_actions: 1
    "BTree.Put":
        max_actions: 2
    "BTree.Delete":
        max_actions: 2
---

NOT_FOUND = "NOT_FOUND"
KEYS = ["a", "b", "c", "d", "e"]
RANGE_BOUNDS = ["", "a", "b", "c", "d", "e", "f"]

# Ordered B+Tree & range-scan contract specification.
# With 5 keys ("a".."e"), BulkLoad, and MaxLeafKeys=2 / MaxBranchKeys=2 /
# MaxFreelistIDs=2 in the Go adapter (with freelist ENABLED), traces reach
# 3-level branch-of-branches trees, branch splits, multi-level collapses,
# empty-tree transitions, multi-page freelist chains, and [start, end) scans.
role BTree:
    action Init:
        self.txid = 0
        self.entries = {}

    # Atomically inserts all 5 keys in a single transaction, immediately
    # constructing a 3-level branch-split B+Tree so subsequent Put/Delete
    # operations exercise deep branch splits and collapses.
    atomic action BulkLoad:
        self.txid += 1
        tag = "b" + str(self.txid)
        for k in KEYS:
            self.entries[k] = tag + "_" + k
        return tag

    atomic action Put:
        k = oneof KEYS
        self.txid += 1
        v = "v" + str(self.txid)
        self.entries[k] = v
        return v

    atomic action Delete:
        k = oneof KEYS
        self.txid += 1
        if k in self.entries:
            self.entries.pop(k)
        return "OK"

    atomic action Get:
        k = oneof KEYS
        return self.entries.get(k, NOT_FOUND)

    atomic action ScanRange:
        start = oneof RANGE_BOUNDS
        end = oneof RANGE_BOUNDS
        parts = []
        for k in sorted(self.entries.keys()):
            if start != "" and k < start:
                continue
            if end != "" and k >= end:
                break
            parts.append(k + "=" + self.entries[k])
        return ",".join(parts)

action Init:
    tree = BTree()

always assertion BoundedKeyDomain:
    for k in tree.entries:
        if k not in KEYS:
            return False
    return True
